# db-import config. Copy to configs/<job>.env and edit:   cp config.example.env configs/prod_to_uat.env
# Run:  ./db-import.sh --check   configs/prod_to_uat.env     (read only: shows the plan)
#       ./db-import.sh --dry-run configs/prod_to_uat.env     (does everything, then ROLLBACK)
#       ./db-import.sh           configs/prod_to_uat.env     (real run)
# Plain bash syntax: NAME="value", no spaces around '='. NO PASSWORDS in this file (see *_PASSWORD_ENV).

JOB_NAME="prod_to_uat"           # names the report folder

# ---- SOURCE (read only) -------------------------------------------------------------------------
# SOURCE_TYPE: postgres | duckdb | ducklake | parquet
SOURCE_TYPE="postgres"
SOURCE_HOST="10.201.170.205"     # empty = local socket
SOURCE_PORT="5432"
SOURCE_DB="gsb"
SOURCE_USER="postgres"
# Name of an environment variable that holds the password (export it before the run), or empty to use ~/.pgpass.
# The plain PGPASSWORD variable is ignored on purpose, so two databases never share one by mistake.
SOURCE_PASSWORD_ENV="SOURCE_PGPASSWORD"
SOURCE_SCHEMA="gsb_data_prd"
# duckdb:   SOURCE_DB_FILE="/path/to/file.duckdb"          (plus SOURCE_SCHEMA, normally "main")
# ducklake: SOURCE_DB = the Postgres database that holds the DuckLake metadata (e.g. "ducklake"), plus
#           SOURCE_DUCKLAKE_DATA_PATH="/mnt/mfs/gsb_data/duckdb/ducklake"
#           SOURCE_DUCKLAKE_METADATA_SCHEMA="metadata"
# parquet:  SOURCE_PARQUET_GLOB="/data/export/{TABLE}/*.parquet"     ({TABLE} = the source table name)

# ---- TARGET (written) ---------------------------------------------------------------------------
# TARGET_TYPE: postgres | duckdb | ducklake      (not parquet)
TARGET_TYPE="postgres"
TARGET_ENV="uat"                 # dev | uat | prod.  prod asks you to type the database name first (or pass --yes)
TARGET_HOST="10.201.170.205"
TARGET_PORT="5432"
TARGET_DB="gsb"
TARGET_USER="postgres"
TARGET_PASSWORD_ENV="TARGET_PGPASSWORD"
TARGET_SCHEMA="gsb_data"         # empty = same as SOURCE_SCHEMA

# ---- WHAT TO COPY -------------------------------------------------------------------------------
# Comma separated (new lines are fine). "SOURCE_NAME=TARGET_NAME" when the target table is named differently.
# The target tables must already exist: the script never creates them.
TABLES="KPI_NS_QRLY_CELL_LTE_ERS_P,
KPI_NS_QRLY_CELL_5G_ERS_P=KPI_NS_QRLY_CELL_5G_ERS_NEW_P"

# The period: PERIOD_FROM <= TIME_COLUMN < PERIOD_TO (TO is not included).
# TIMEZONE: the time zone the period is written in, and the zone used when a time-zone-aware column is read or copied
# into a plain "timestamp" column. Default UTC. The gsb pivot data is Sydney time: set TIMEZONE="Australia/Sydney" on
# uat / prod (and on dev). Columns that are already plain "timestamp" are not affected by it.
# A date alone means 00:00:00. Also accepted: "2026-11-01 06:00" and "2026-11-01 06:00:00". Nothing else.
PERIOD_FROM="2026-11-01"
PERIOD_TO="2026-11-03"           # = all of 1 Nov and 2 Nov
TIME_COLUMN="PERIOD_START_TIME"
TIMEZONE="Australia/Sydney"
# Only for a table whose time column has another name:  TABLE:COLUMN,TABLE:COLUMN
TABLE_TIME_COLUMNS=""
# Tables with no time column that must be copied whole (the whole target table is replaced). Normally empty.
FULL_COPY_TABLES=""

# ---- HOW ----------------------------------------------------------------------------------------
# replace = delete the target rows of the period, then insert the source rows (one transaction; safe to re-run)
# append  = only insert (running twice duplicates rows)
# stop    = refuse if the target already has rows for the period
LOAD_MODE="replace"
# on  = the target rows that are replaced are first copied to BACKUP_SCHEMA."<table>_bak_<date_time>" in the TARGET database
# off = no backup (a warning is printed)
BACKUP="on"
BACKUP_SCHEMA="import_backup"
# stop = stop at the first failed table; continue = go on with the next table (failed tables are rolled back)
ON_ERROR="stop"

# ---- DuckDB / offline (only when DuckDB, DuckLake or parquet is involved) -------------------------
# yes = DuckDB loads extensions ONLY from ./bundle (made by prepare-bundle.sh). Use yes on uat/prod (no internet).
# no  = DuckDB may download extensions (a machine with internet, e.g. dev).
OFFLINE="yes"
DUCKDB="duckdb"                  # path of the DuckDB CLI; ./bundle/duckdb is used first when it exists
# BUNDLE_DIR="/path/to/bundle"   # default: ./bundle next to the script
# REPORT_DIR="/path/to/reports"  # default: ./reports next to the script
