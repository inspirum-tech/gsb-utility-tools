# db-import config. Copy to configs/<job>.env and edit:   cp config.example.env configs/prod_to_uat.env
# Run:  ./db-import.sh --check   configs/prod_to_uat.env     (read only: shows the plan)
#       ./db-import.sh --dry-run configs/prod_to_uat.env     (does everything, then ROLLBACK)
#       ./db-import.sh           configs/prod_to_uat.env     (real run)
# Plain bash syntax: NAME="value", no spaces around '='. NO PASSWORDS in this file (see *_PASSWORD_ENV).

JOB_NAME="prod_to_uat"           # names the report folder

# ---- SOURCE (read only) -------------------------------------------------------------------------
# SOURCE_TYPE: postgres | duckdb | ducklake | parquet | flightsql | csv
SOURCE_TYPE="postgres"
SOURCE_HOST="10.201.170.205"     # empty = local socket
SOURCE_PORT="5432"
SOURCE_DB="gsb"
SOURCE_USER="postgres"
# Name of an environment variable that holds the password (export it before the run), or empty to use ~/.pgpass.
# The plain PGPASSWORD variable is ignored on purpose, so two databases never share one by mistake.
SOURCE_PASSWORD_ENV="SOURCE_PGPASSWORD"
SOURCE_SCHEMA="gsb_data_prd"
# duckdb:   SOURCE_DB_FILE="/path/to/file.duckdb"          (plus SOURCE_SCHEMA, normally "main")
# ducklake: SOURCE_DB = the Postgres database that holds the DuckLake metadata (e.g. "ducklake"), plus
#           SOURCE_DUCKLAKE_DATA_PATH="/mnt/mfs/gsb_data/duckdb/ducklake"
#           SOURCE_DUCKLAKE_METADATA_SCHEMA="metadata"
# parquet:  SOURCE_PARQUET_GLOB="/data/export/{TABLE}/*.parquet"     ({TABLE} = the source table name)

# ---- TARGET (written) ---------------------------------------------------------------------------
# TARGET_TYPE: postgres | duckdb | ducklake      (not parquet)
TARGET_TYPE="postgres"
TARGET_ENV="uat"                 # dev | uat | prod.  prod asks you to type the database name first (or pass --yes)
TARGET_HOST="10.201.170.205"
TARGET_PORT="5432"
TARGET_DB="gsb"
TARGET_USER="postgres"
TARGET_PASSWORD_ENV="TARGET_PGPASSWORD"
TARGET_SCHEMA="gsb_data"         # empty = same as SOURCE_SCHEMA

# ---- WHAT TO COPY -------------------------------------------------------------------------------
# Comma separated (new lines are fine). "SOURCE_NAME=TARGET_NAME" when the target table is named differently.
# The target tables must already exist: the script never creates them.
# SOURCE_TYPE="csv" only: TABLES="auto" = every table found in the files (see the csv block at the end).
TABLES="KPI_NS_QRLY_CELL_LTE_ERS_P,
KPI_NS_QRLY_CELL_5G_ERS_P=KPI_NS_QRLY_CELL_5G_ERS_NEW_P"

# The period: PERIOD_FROM <= TIME_COLUMN < PERIOD_TO (TO is not included).
# TIMEZONE: the time zone the period is written in, and the zone used when a time-zone-aware column is read or copied
# into a plain "timestamp" column. Default UTC. The gsb pivot data is Sydney time: set TIMEZONE="Australia/Sydney" on
# uat / prod (and on dev). Columns that are already plain "timestamp" are not affected by it.
# A date alone means 00:00:00. Also accepted: "2026-11-01 06:00" and "2026-11-01 06:00:00". Nothing else.
# SOURCE_TYPE="csv" only: PERIOD_FROM="auto" and/or PERIOD_TO="auto" = from the first / to the last row of each table's files.
# With both "auto" every row in the files is loaded (and only the target rows of that same range are replaced); each table uses
# its own range. A fixed date still loads only that part. The gap check still applies inside the range of the files.
PERIOD_FROM="2026-11-01"
PERIOD_TO="2026-11-03"           # = all of 1 Nov and 2 Nov
TIME_COLUMN="PERIOD_START_TIME"
TIMEZONE="Australia/Sydney"
# Only for a table whose time column has another name:  TABLE:COLUMN,TABLE:COLUMN
TABLE_TIME_COLUMNS=""
# Tables with no time column that must be copied whole (the whole target table is replaced). Normally empty.
FULL_COPY_TABLES=""

# ---- HOW ----------------------------------------------------------------------------------------
# replace = delete the target rows of the period, then insert the source rows (one transaction; safe to re-run)
# append  = only insert (running twice duplicates rows)
# stop    = refuse if the target already has rows for the period
LOAD_MODE="replace"
# on  = the target rows that are replaced are first copied to BACKUP_SCHEMA."<table>_bak_<date_time>" in the TARGET database
# off = no backup (a warning is printed)
BACKUP="on"
BACKUP_SCHEMA="import_backup"
# stop = stop at the first failed table; continue = go on with the next table (failed tables are rolled back)
ON_ERROR="stop"

# ---- DuckDB / offline (only when DuckDB, DuckLake or parquet is involved) -------------------------
# yes = DuckDB loads extensions ONLY from ./bundle (made by prepare-bundle.sh). Use yes on uat/prod (no internet).
# no  = DuckDB may download extensions (a machine with internet, e.g. dev).
OFFLINE="yes"
DUCKDB="duckdb"                  # path of the DuckDB CLI; ./bundle/duckdb is used first when it exists
# BUNDLE_DIR="/path/to/bundle"   # default: ./bundle next to the script
# REPORT_DIR="/path/to/reports"  # default: ./reports next to the script

# ---- SOURCE_TYPE="flightsql": read through the gsb-kpi-data-api Flight SQL interface ---------------
# Use this when the source database's data files cannot be reached from this machine (for example prod
# from UAT): only a tunnel to the API's Flight SQL port is needed. The tool reads the period in small
# time slices (one query at a time, with a pause), writes them as parquet files into EXPORT_DIR, then
# imports those files like a parquet source (same backup, transaction, row-count check, --dry-run).
#   SOURCE_HOST / SOURCE_PORT = the API or the tunnel to it (port 8815 by default); no login, no TLS
#   SOURCE_SCHEMA             = the schema on the API, e.g. gsb_data_kpi_pivot
#   TABLES                    = table names on the API; the target table may have another name (SOURCE=TARGET)
# The time column is found by name, upper or lower case (TIME_COLUMN / TABLE_TIME_COLUMNS as for any source).
# Needs Python 3 with pyarrow and adbc-driver-flightsql: on an offline server they come from ./bundle/pylibs.
# SOURCE_TYPE="flightsql"
# SOURCE_HOST="localhost"
# SOURCE_PORT="8815"
# SOURCE_SCHEMA="gsb_data_kpi_pivot"
# The API stops a query at its row cap (default 100000) and cuts the result silently. A slice that
# returns that many rows or more FAILS the table (nothing is imported); then lower FLIGHT_SLICE_MINUTES.
# FLIGHT_MAX_ROWS="100000"         # set to the API's real cap (FLIGHTSQL__MAX_ROWS)
# FLIGHT_SLICE_MINUTES="10"        # length of one slice
# FLIGHT_PAUSE_SECONDS="2"         # wait between two slices, so the API is not loaded
# FLIGHT_TIMEOUT_SECONDS="120"     # per query
# EXPORT_DIR="/data/db-import-export"   # default: <report folder of the run>/export
# EXPORT_KEEP="yes"                # yes = keep the files, so the same data can be imported again without asking the API;
#                                  # no  = remove them at the end of the run
# EXPORT_OVERWRITE="no"            # yes = replace an earlier export of the same table in EXPORT_DIR (default: refuse)
# PYTHON="python3"
# To only fetch the data (no database is touched, the TARGET_* settings are not used):  ./db-import.sh --export-only <config>
# To import kept files later: SOURCE_TYPE="parquet" and SOURCE_PARQUET_GLOB="<EXPORT_DIR>/{TABLE}/*.parquet"

# ---- SOURCE_TYPE="csv": the CSV files downloaded from prod (no connection to prod at all) -----------
# A teammate downloads the data from prod as a zip. Upload that zip to the server as ONE file (bulk is much
# faster than many small files) and point SOURCE_CSV_PATH at it; an already unzipped folder works too.
# Inside: one folder per table, with one file per time range and a _manifest.csv (file,rows):
#     NODE_EPNGU/KPI_NS_QRLY_NODE_EPNGU_ERS_P_2026-10-25_00_00_00__to__2026-10-25_01_00_00.csv.gz
# The TABLE name is read from the file names (not from the folder), so any table family works.
# The files are read by DuckDB (every column as text, cast to the target's column types on insert), then
# imported like any other source: PERIOD_FROM / PERIOD_TO, LOAD_MODE, BACKUP, --check, --dry-run all apply.
# Set TABLES="auto" to import every table found in the files for the period, or list the tables as usual
# (target name can differ: "SOURCE_NAME=TARGET_NAME"). TARGET_* is the DuckLake target.
# Before anything is written the script checks: the files cover the whole period without a gap or overlap, and each
# file's row count equals its _manifest.csv line. A download that is incomplete stops the run.
# SOURCE_TYPE="csv"
# SOURCE_CSV_PATH="/data/upload/export_nonstd.zip"   # a .zip file, or the folder with the CSV files, or a FOLDER OF ZIPS:
#                                  # a folder that holds .zip files (any number) imports them one after the other in name order
#                                  # (01_nstd.zip before 02_other.zip), each as its own run, and stops at the first failure.
#                                  # Before anything is imported the zips are listed and refused if the same table and time
#                                  # range is in two zips or if together they leave a gap. Name the zips in the order you want.
# CSV_WORK_DIR=""                  # where a zip is unzipped (default: the run's temp folder; needs about the zip's size free)
# CSV_KEEP_EXTRACTED="no"          # yes = keep the unzipped files after the run (a folder you gave is never removed)
# CSV_CHECK_MANIFEST="yes"         # compare each file's rows with its _manifest.csv (reads every file once more)
# CSV_INCOMPLETE="error"           # error = stop when a period/file is missing or a count differs; warn = only warn
# EXTRA_SOURCE_COLUMNS="error"     # the data has columns the target table lacks: error = stop and list them;
#                                  # skip = load only the columns the target has (listed in <report folder>/skipped_columns.txt).
#                                  # Use skip only when the owner of the data has said these columns are not needed.
# TARGET_STRUCTURE="strict"        # strict = the target schema, tables and columns must already fit (stop otherwise, as before)
#                                  # create = the prod data is the truth and is loaded as it is: a schema that does not exist is created,
#                                  # a table that does not exist is created from the CSV columns, columns the CSV has and the table lacks
#                                  # are ADDED (nothing is ever dropped; columns only the table has stay empty).
#                                  # --check lists every statement before anything happens; they run in the same transaction as the data
#                                  # (so --dry-run rolls them back) and are saved in <report folder>/structure_changes.sql.
#                                  # A created table or added column stays after a real run: use create on purpose (csv source only).
# CSV_COLUMN_TYPES="PERIOD_START_TIME=TIMESTAMP; UPDATE_TIMESTAMP=TIMESTAMP; SITE_ID=INTEGER; CELL_ID=INTEGER; LAC=DECIMAL(4,2); SAC=DECIMAL(4,2); TAC=DECIMAL(10,2); K_*=DECIMAL(30,10); *=VARCHAR"
#                                  # (this default = the types of the real *_ERS_P pivot tables; LAC / SAC are always empty in the prod data)
#                                  # types for NEW tables / columns only (existing columns keep their type): "COLUMN=TYPE; ..." separated by ;
#                                  # the first matching rule wins, * matches any characters. This is the default.
# TIMEZONE="Australia/Sydney"      # the text times in the CSV are Sydney local time; set it as for the other sources
