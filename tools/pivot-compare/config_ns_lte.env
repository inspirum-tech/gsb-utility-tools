# Settings of the pivot comparison. This file is read by run.sh (shell syntax: NAME=value, no spaces around =).
# Nothing about tables, columns, keys, periods or tolerance is written in the SQL files: it all comes from here.
# Use another file with:  ./run.sh path/to/other.env
# Every name and list below is checked (letters, digits and _ only; see README) before any SQL is built.
#
# NS LTE cell quarter-hourly on dev: old pivot (Postgres, UAT output loaded 2026-11-03, Sydney time) against the new pivot
# table in DuckLake gsb_data_kpi_pivot_dev. Overlap: 2026-10-25 00:00 to 01:00 Sydney = 5 periods. KPI ids can be negative.

# ---- what to compare -------------------------------------------------------------------------
# Period window in UTC, half open: FROM <= period < TO. One 15-minute period = FROM and FROM + 15 minutes.
PERIOD_FROM="2026-10-24 13:00:00+00"
PERIOD_TO="2026-10-24 14:15:00+00"

# MODE=auto   : you do NOT name the tables. The script reads the KPI definitions (DEF_* below), groups the KPIs of the
#               chosen applications into families (application, resolution, level, technology, vendor), builds the
#               old pivot table name of each family by the pattern below, and compares every family whose old table
#               exists (a family without an old table is listed as SKIPPED). In auto mode OLD_TABLE is ignored and
#               NEW_FILTER_VALUE is filled in per family; the new rows are limited to the family's KPI ids.
# MODE=manual : you name one OLD_TABLE (and the filter on the new side) and get one comparison.
MODE=manual
# auto: ALL, or application names separated by commas (as written in KPI_DEFINITION.APPLICATION)
AUTO_APPLICATIONS=ENIQS_CAT6
# auto: where the KPI definitions are (same kinds of source as OLD_SOURCE / NEW_SOURCE below)
DEF_SOURCE=postgres
DEF_DSN_ENV=KPI_ENGINE_PG_DSN
DEF_CATALOG=
DEF_DB_FILE=
DEF_SCHEMA=gsb_data
DEF_TABLE=KPI_DEFINITION
DEF_COL_KPI_ID=KPI_ID
DEF_COL_APPLICATION=APPLICATION
DEF_COL_RESOLUTION=TIME_AGGREGATE
DEF_COL_LEVEL=NETWORK_LEVEL
DEF_COL_TECHNOLOGY=TECHNOLOGY
DEF_COL_VENDOR=VENDOR
# auto: the name rule of the pivot tables (the same rule the new engine uses). Parts are upper-cased, any character
# other than letters, digits and _ becomes _ (so NB-IoT gives NB_IOT). AUTO_RES_TOKENS: resolution letter = name part.
AUTO_OLD_TABLE_PATTERN=KPI_{APPLICATION}_{RES}_{LEVEL}_{TECH}_{VENDOR}_P
AUTO_RES_TOKENS=Q=QRLY,H=HRLY,D=DAILY,W=WKLY,M=MTHLY
# auto: text put in front of a KPI id to get the pivot column name (K_1, K_2, ...)
AUTO_KPI_PREFIX=K_

# ---- OLD side (the Java calculator's pivot) --------------------------------------------------
# OLD_SOURCE: postgres  = attach a Postgres database read only (connection string from DSN_ENV, see below)
#             attached  = a catalog that DuckDB already attached itself (for example DuckLake in ~/.duckdbrc), name in OLD_CATALOG
#             duckdb    = a DuckDB file, path in OLD_DB_FILE (used by the local test)
OLD_SOURCE=postgres
OLD_DSN_ENV=KPI_ENGINE_PG_DSN
OLD_CATALOG=
OLD_DB_FILE=
OLD_SCHEMA=gsb_data_kpi_pivot
OLD_TABLE=KPI_NS_QRLY_CELL_LTE_ERS_P
# SHAPE: wide = one column per KPI (a pivot table); tall = one row per KPI (KPI_CALCULATED)
OLD_SHAPE=wide
OLD_PERIOD_COL=PERIOD_START_TIME
# PERIOD_KIND: local = timestamp without time zone, stored in the time zone OLD_PERIOD_TZ
#              tz    = timestamp with time zone
OLD_PERIOD_KIND=local
OLD_PERIOD_TZ=Australia/Sydney
# Key of one object inside a period (the period itself is always part of the key). Same count on both sides, same order.
OLD_KEY_COLS=SITE_ID,CELL_ID
# Optional row filter: only rows where FILTER_COL = FILTER_VALUE
OLD_FILTER_COL=
OLD_FILTER_VALUE=
# wide: regular expression that selects the KPI columns
OLD_KPI_REGEX='^K_-?[0-9]+$'
# tall: column with the KPI id, column with the value, text put in front of the id to make the KPI column name
OLD_KPI_COL=
OLD_VALUE_COL=
OLD_KPI_PREFIX=K_

# ---- NEW side (the Rust kpi-engine) ----------------------------------------------------------
NEW_SOURCE=attached
NEW_DSN_ENV=
NEW_CATALOG=gsb
NEW_DB_FILE=
NEW_SCHEMA=gsb_data_kpi_pivot_dev
NEW_TABLE=KPI_NS_QRLY_CELL_LTE_ERS_NEW_P
NEW_SHAPE=wide
NEW_PERIOD_COL=PERIOD_START_TIME
NEW_PERIOD_KIND=tz
NEW_PERIOD_TZ=UTC
NEW_KEY_COLS=SITE_ID,CELL_ID
NEW_FILTER_COL=
NEW_FILTER_VALUE=
NEW_KPI_REGEX='^K_-?[0-9]+$'
NEW_KPI_COL=KPI_ID
NEW_VALUE_COL=KPI_VALUE
NEW_KPI_PREFIX=K_

# Where the connection strings are read from when OLD_SOURCE / NEW_SOURCE is postgres:
# first the environment variable named in *_DSN_ENV, else the line NAME=... in this file. Never printed.
ENV_FILE=../../.env

# ---- which KPI columns ------------------------------------------------------------------------
# Applied to the final KPI column names of both sides. Default: all KPI columns that exist on both sides.
KPI_REGEX='^K_-?[0-9]+$'
# Optional: a text file with one KPI column per line (only these are compared). Empty = all common columns.
KPI_LIST_FILE=
# Optional: a CSV with the header  old_kpi,new_kpi  when the NEW side names a KPI differently. Empty = same names.
KPI_MAP_FILE=

# ---- how values are compared ------------------------------------------------------------------
# Two values are equal when  abs(old-new) <= TOLERANCE_ABS + TOLERANCE_REL * abs(old) + FLOAT_SLACK.
# The new calculator rounds to 8 decimals (HALF_EVEN) like Java, so 1e-8 is the natural size.
# FLOAT_SLACK only absorbs binary floating point noise (a 1e-8 step can show as 1.0000000000000002e-8).
TOLERANCE_ABS=0.00000001
TOLERANCE_REL=0
FLOAT_SLACK=0.000000000001
# Java replaces null, NaN and infinite KPI values by DIVIDE_BY_ZERO_DEFAULT (-1 when empty).
# SPECIAL_AS_DEFAULT=yes : NaN and +-infinity on either side are read as SPECIAL_DEFAULT before comparing.
# NULL_AS_DEFAULT=yes    : NULL (or a missing value) is read as SPECIAL_DEFAULT too. Default no, so that
#                          "NULL against a value" is reported instead of being hidden.
SPECIAL_AS_DEFAULT=yes
SPECIAL_DEFAULT=-1
NULL_AS_DEFAULT=no

# ---- verdict ------------------------------------------------------------------------------------
# A different value always makes the verdict DIFFERENT. These decide whether the rest does too:
FAIL_ON_OBJECTS_ONE_SIDE=yes
FAIL_ON_KPI_COLUMNS_ONE_SIDE=no
FAIL_ON_NULL_ONE_SIDE=yes

# ---- CM (configuration management) comparison ---------------------------------------------------
# CM_COMPARE=yes also compares the CM table of the old side with the CM table of the new side (a CM change or a late CM
# load can explain a KPI mismatch). no = the CM step does not run at all. The report goes to REPORT_DIR/cm/.
# Sources are described like the OLD / NEW sides above (SOURCE postgres | attached | duckdb).
CM_COMPARE=no
CM_OLD_SOURCE=postgres
CM_OLD_DSN_ENV=KPI_ENGINE_PG_DSN
CM_OLD_CATALOG=
CM_OLD_DB_FILE=
CM_OLD_SCHEMA=gsb_data_cm
CM_OLD_TABLE=CM_ERS_LTE_CALC
CM_NEW_SOURCE=postgres
CM_NEW_DSN_ENV=KPI_ENGINE_PG_DSN
CM_NEW_CATALOG=
CM_NEW_DB_FILE=
CM_NEW_SCHEMA=gsb_data_cm_backup
CM_NEW_TABLE=CM_ERS_LTE_CALC
# One CM object = these columns joined with | (same names on both sides)
CM_KEY_COLS=CELL_NAME
# History: the row in force at PERIOD_TO is used = the latest row with CM_ASOF_COL <= PERIOD_TO (a timestamp WITHOUT time
# zone in CM_ASOF_TZ). Empty CM_ASOF_COL = the table has no history, every row counts.
CM_ASOF_COL=INSERT_DT
CM_ASOF_TZ=Australia/Sydney
# Columns that are not compared (the key columns and the as-of column are never compared)
CM_EXCLUDE_COLS=
CM_FAIL_ON_OBJECTS_ONE_SIDE=yes
CM_FAIL_ON_COLUMNS_ONE_SIDE=no

# ---- output and resources ----------------------------------------------------------------------
REPORT_DIR=report_ns_lte
# Most rows written to differences.csv (the summary always has the true counts).
MAX_DIFF_ROWS=1000000
DUCKDB=/mnt/mfs/gsb_application/gsb-dedup-service/duckdb-cli/duckdb
# Optional DuckDB limits. Empty = DuckDB default. On the shared dev server set TEMP_DIR to a folder with free space.
MEMORY_LIMIT=
TEMP_DIR=/mnt/mfs/gsb_application/pems-dbt-calculator/tall-engine-and-final-schema/old_cal_import/tmp
THREADS=
