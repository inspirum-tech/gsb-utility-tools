# Settings of the pivot comparison. This file is read by run.sh (shell syntax: NAME=value, no spaces around =).
# Nothing about tables, columns, keys, periods or tolerance is written in the SQL files: it all comes from here.
# Use another file with:  ./run.sh path/to/other.env
# Every name and list below is checked (letters, digits and _ only; see README) before any SQL is built.
#
# Example now: ENIQS CAT6 LTE ERS quarter-hourly, old Java pivot (Postgres, Sydney time)
# against the new engine's tall table (Postgres, timestamptz), on dev.

# ---- what to compare -------------------------------------------------------------------------
# Period window in UTC, half open: FROM <= period < TO. One 15-minute period = FROM and FROM + 15 minutes.
PERIOD_FROM="2025-12-19 09:00:00+00"
PERIOD_TO="2025-12-19 09:15:00+00"

# ---- OLD side (the Java calculator's pivot) --------------------------------------------------
# OLD_SOURCE: postgres  = attach a Postgres database read only (connection string from DSN_ENV, see below)
#             attached  = a catalog that DuckDB already attached itself (for example DuckLake in ~/.duckdbrc), name in OLD_CATALOG
#             duckdb    = a DuckDB file, path in OLD_DB_FILE (used by the local test)
OLD_SOURCE=postgres
OLD_DSN_ENV=KPI_ENGINE_PG_DSN
OLD_CATALOG=
OLD_DB_FILE=
OLD_SCHEMA=gsb_data_kpi_pivot
OLD_TABLE=KPI_ENIQS_CAT6_QRLY_CELL_LTE_ERS_P
# SHAPE: wide = one column per KPI (a pivot table); tall = one row per KPI (KPI_CALCULATED)
OLD_SHAPE=wide
OLD_PERIOD_COL=PERIOD_START_TIME
# PERIOD_KIND: local = timestamp without time zone, stored in the time zone OLD_PERIOD_TZ
#              tz    = timestamp with time zone
OLD_PERIOD_KIND=local
OLD_PERIOD_TZ=Australia/Sydney
# Key of one object inside a period (the period itself is always part of the key). Same count on both sides, same order.
OLD_KEY_COLS=SITE_ID,CELL_ID
# Optional row filter: only rows where FILTER_COL = FILTER_VALUE
OLD_FILTER_COL=
OLD_FILTER_VALUE=
# wide: regular expression that selects the KPI columns
OLD_KPI_REGEX='^K_[0-9]+$'
# tall: column with the KPI id, column with the value, text put in front of the id to make the KPI column name
OLD_KPI_COL=
OLD_VALUE_COL=
OLD_KPI_PREFIX=K_

# ---- NEW side (the Rust kpi-engine) ----------------------------------------------------------
NEW_SOURCE=postgres
NEW_DSN_ENV=KPI_ENGINE_PG_DSN
NEW_CATALOG=
NEW_DB_FILE=
NEW_SCHEMA=gsb_data_kpi_base
NEW_TABLE=KPI_CALCULATED
NEW_SHAPE=tall
NEW_PERIOD_COL=PERIOD_START_TIME
NEW_PERIOD_KIND=tz
NEW_PERIOD_TZ=UTC
NEW_KEY_COLS=SITE_ID,CELL_ID
NEW_FILTER_COL=APPLICATION
NEW_FILTER_VALUE=ENIQS_CAT6
NEW_KPI_REGEX='^K_[0-9]+$'
NEW_KPI_COL=KPI_ID
NEW_VALUE_COL=KPI_VALUE
NEW_KPI_PREFIX=K_

# Where the connection strings are read from when OLD_SOURCE / NEW_SOURCE is postgres:
# first the environment variable named in *_DSN_ENV, else the line NAME=... in this file. Never printed.
ENV_FILE=../../.env

# ---- which KPI columns ------------------------------------------------------------------------
# Applied to the final KPI column names of both sides. Default: all KPI columns that exist on both sides.
KPI_REGEX='^K_[0-9]+$'
# Optional: a text file with one KPI column per line (only these are compared). Empty = all common columns.
KPI_LIST_FILE=
# Optional: a CSV with the header  old_kpi,new_kpi  when the NEW side names a KPI differently. Empty = same names.
KPI_MAP_FILE=

# ---- how values are compared ------------------------------------------------------------------
# Two values are equal when  abs(old-new) <= TOLERANCE_ABS + TOLERANCE_REL * abs(old) + FLOAT_SLACK.
# The new calculator rounds to 8 decimals (HALF_EVEN) like Java, so 1e-8 is the natural size.
# FLOAT_SLACK only absorbs binary floating point noise (a 1e-8 step can show as 1.0000000000000002e-8).
TOLERANCE_ABS=0.00000001
TOLERANCE_REL=0
FLOAT_SLACK=0.000000000001
# Java replaces null, NaN and infinite KPI values by DIVIDE_BY_ZERO_DEFAULT (-1 when empty).
# SPECIAL_AS_DEFAULT=yes : NaN and +-infinity on either side are read as SPECIAL_DEFAULT before comparing.
# NULL_AS_DEFAULT=yes    : NULL (or a missing value) is read as SPECIAL_DEFAULT too. Default no, so that
#                          "NULL against a value" is reported instead of being hidden.
SPECIAL_AS_DEFAULT=yes
SPECIAL_DEFAULT=-1
NULL_AS_DEFAULT=no

# ---- verdict ------------------------------------------------------------------------------------
# A different value always makes the verdict DIFFERENT. These decide whether the rest does too:
FAIL_ON_OBJECTS_ONE_SIDE=yes
FAIL_ON_KPI_COLUMNS_ONE_SIDE=no
FAIL_ON_NULL_ONE_SIDE=yes

# ---- output and resources ----------------------------------------------------------------------
REPORT_DIR=report
# Most rows written to differences.csv (the summary always has the true counts).
MAX_DIFF_ROWS=1000000
DUCKDB=duckdb
# Optional DuckDB limits. Empty = DuckDB default. On the shared dev server set TEMP_DIR to a folder with free space.
MEMORY_LIMIT=
TEMP_DIR=
THREADS=
