# export config (read by export-on-prod.sh, ON THE PROD SERVER). Copy to export.env next to the script and edit.
# The tables, the period and the zip name are NOT set here when run-all.sh starts the export: it passes them.
# They are only needed here when you run the export by hand.  NO PASSWORD in this file.

# ---- PostgreSQL source only (skip this section for DuckLake-only exports) -------------------------------------------------------------------------
PSQL_BIN="psql"                         # or an absolute path on prod
PGHOST="<prod database host>"
PGPORT="5432"
PGUSER="<a read-only user>"
PGDATABASE="gsb"
# The password: EITHER a ~/.pgpass line for the user that runs the export (chmod 600):
#       <host>:5432:gsb:<user>:<password>        <- recommended; this also works when run-all.sh starts the export over SSH
# OR the NAME of an environment variable that holds it (set it in the terminal before a manual run):
#       read -rs PG_PASS; export PG_PASS    and    PG_PASSWORD_ENV="PG_PASS"
PG_PASSWORD_ENV=""

# ---- DuckLake source only (skip this section for PostgreSQL-only exports)
DUCKDB_BIN="duckdb"                     # on the SSH account PATH, or set an absolute path
# Set this to the protected local SQL file that attaches the prod lake AS gsb (READ_ONLY).
DUCKLAKE_INIT="/path/on/prod/ducklake-read-only.sql"
# See the runbook for the required read-only gsb attachment. No Flight SQL.

# ---- what and where ---------------------------------------------------------------------------------------------------
SCHEMA="gsb_data_kpi_pivot"             # legacy PostgreSQL TABLES only; qualified lists supply their own schema
TS_COL="PERIOD_START_TIME"              # the time column the period is cut on (all tables)
# TABLE_TIME_COLUMNS="TABLE_A:OTHER_COL,TABLE_B:OTHER_COL"    # only for a table whose time column has another name
OUT_ROOT="/path/on/prod/export_out"     # the zip is written here (letters, digits, _ . / - only)

# ---- how --------------------------------------------------------------------------------------------------------------
STEP_HOURS="1"                          # one file per table per this many hours
# Supported: LITERAL | SYD_LOCAL_ON_UTC_TS | SYD_LOCAL_ON_TZ_COL
TZ_MODE="LITERAL"                       # LITERAL = the column is a plain timestamp compared as written (the pivot tables)
SKIP_EMPTY="no"                         # no = an hour without rows still gets a header-only file, so db-import sees no gap
RESUME="no"                             # yes = continue a stopped run of the same name (also --resume)
MIN_FREE_MB="1024"                      # stop if the output folder has less free space

# ---- for a manual run only (run-all.sh passes these) ---------------------------------------------------------------------
# Choose qualified source lists (either or both); output table basenames must be unique.
# POSTGRES_TABLES="pg_schema.TABLE_A"
# DUCKLAKE_TABLES="lake_schema.TABLE_B"
# Or use the legacy PostgreSQL-only list, not alongside the qualified lists:
# TABLES="KPI_NS_QRLY_NODE_CEM_ERS_P,KPI_NS_QRLY_NODE_IST_ERS_P"
# PERIOD_FROM="2026-10-25"
# PERIOD_TO="2026-10-26"
# ZIP_NAME="nstd_test"
