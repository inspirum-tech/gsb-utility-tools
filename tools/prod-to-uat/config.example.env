# run-all config (runs on UAT). Copy to configs/<job>.env and edit:   cp config.example.env configs/nstd_prod_to_uat.env
# Run:  ./run-all.sh --check   configs/nstd_prod_to_uat.env     (read only: SSH, the export's own check on prod, disk, configs)
#       ./run-all.sh --dry-run configs/nstd_prod_to_uat.env     (export + copy for real; the load is rolled back; no compare)
#       ./run-all.sh           configs/nstd_prod_to_uat.env     (the whole chain)
# Plain bash syntax: NAME="value", no spaces around '='. NO PASSWORDS in this file.

JOB_NAME="nstd_prod_to_uat"

# ---- PROD: how UAT reaches it (the tunnel must be open) ------------------------------------------------------
REMOTE_MODE="ssh"                       # ssh | local (local = run the prod step on this machine; only for tests)
PROD_SSH_HOST="<prod server or tunnel host>"
PROD_SSH_USER="<user on prod>"
PROD_SSH_PORT="22"
PROD_SSH_KEY="<path to the private key on UAT>"       # key login only (no password prompt); empty = the default key
SSH_CONNECT_TIMEOUT="15"

# ---- PROD: the export (export-on-prod.sh and its own config were copied to prod once) ---------------------------
PROD_EXPORT_SCRIPT="/path/on/prod/export-on-prod.sh"
PROD_EXPORT_CONFIG="/path/on/prod/export.env"          # holds the prod database connection (export.example.env)
PROD_OUT_ROOT="/path/on/prod/export_out"               # the zip is written here (letters, digits, _ . / - only)

# ---- WHAT to export (set here once; passed to the export) ----------------------------------------------------------
TABLES="KPI_NS_QRLY_NODE_CEM_ERS_P,KPI_NS_QRLY_NODE_IST_ERS_P"      # table names in the prod schema, comma separated
PERIOD_FROM="2026-10-25"                # PERIOD_FROM <= PERIOD_START_TIME < PERIOD_TO (Sydney wall-clock text); "2026-10-25 03:15" also works
PERIOD_TO="2026-10-26"
ZIP_NAME_PREFIX="nstd"                  # the zip is called <prefix>_<date>_<time>.zip (or --name on the command line)

# ---- UAT: where the zip lands, then the load ------------------------------------------------------------------------
LOCAL_ZIP_DIR="/data/upload"            # needs free space about the size of the zip (the load unzips it again: see CSV_WORK_DIR in the db-import config)
DB_IMPORT_DIR="/path/to/db-import"      # default: ../db-import next to this tool
DB_IMPORT_CONFIG="/path/to/db-import/configs/uat_load_nstd_zip.env"   # a db-import config with SOURCE_TYPE="csv"; this script sets SOURCE_CSV_PATH to the zip it copied

# ---- UAT: the comparison (optional) ------------------------------------------------------------------------------------
COMPARE="no"                            # yes = run pivot-compare after the load
PIVOT_COMPARE_DIR="/path/to/pivot-compare"                 # default: ../pivot-compare next to this tool
PIVOT_COMPARE_CONFIG="/path/to/pivot-compare/config_ns_all.env"

# ---- optional --------------------------------------------------------------------------------------------------------------
# STEPS="export,copy,load,compare"      # run only some steps (also --steps on the command line)
# MIN_FREE_MB="1024"                    # free disk needed besides the zip, on UAT and on prod
# REPORT_DIR="/path/to/reports"         # default: ./reports next to the script
